# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/precision-engine?retryWrites=true&w=majority

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini (for AI recommendations)
GEMINI_API_KEY=your-gemini-api-key

# Storage (default: local)
STORAGE_PROVIDER=local

# Appwrite Storage (required if STORAGE_PROVIDER=appwrite)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=
