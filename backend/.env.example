########################################
# AI Configuration
########################################

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

########################################
# Server Configuration
########################################

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_MODE=development

########################################
# MongoDB
########################################

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=automl_db

########################################
# CORS
########################################

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

########################################
# Logging
########################################

LOG_LEVEL=INFO

########################################
# Upload Limits
########################################

MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=uploads

########################################
# Request Configuration
########################################

REQUEST_TIMEOUT_SECONDS=300

########################################
# Dataset Cache
########################################

DATASET_CACHE_SIZE=3
DATASET_CACHE_TTL_SECONDS=3600
DATASET_CACHE_MAX_MEMORY_MB=1024

########################################
# EDA Limits
########################################

MAX_NUMERICAL_COLS_CORRELATION=50
MAX_NUMERICAL_COLS_HISTOGRAM=20
MAX_DATASET_ROWS_SMOTE=50000
MAX_CATEGORICAL_CARDINALITY=100

########################################
# Machine Learning
########################################

MAX_CV_FOLDS=5

########################################
# Storage & Cleanup
########################################

UPLOAD_RETENTION_DAYS=90
MAX_STORAGE_GB=10
CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true